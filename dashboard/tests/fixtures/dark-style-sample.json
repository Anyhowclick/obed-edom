    { "id": "building", "type": "fill", "source-layer": "building", "paint": { "fill-color": "rgb(10,10,10)", "fill-outline-color": "rgb(27 ,27 ,29)" } },
    { "id": "highway_minor", "type": "line", "source-layer": "transportation", "paint": { "line-color": "#181818" } },
    { "id": "highway_minor_space", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(27 27 29)" } },
    { "id": "highway_major_casing", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgba(60,60,60,0.8)" } },
    { "id": "highway_major_casing_slash", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(60 60 60 / 0.8)" } },
    { "id": "railway", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(35,35,35)" } },
