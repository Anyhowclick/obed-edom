{
  "version": 8,
  "name": "Dark (trimmed sample, modelled on tiles.openfreemap.org/styles/dark)",
  "sources": { "openmaptiles": { "type": "vector", "tiles": ["https://tiles.openfreemap.org/planet/{z}/{x}/{y}.pbf"] } },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "rgb(12,12,12)" } },
    { "id": "water", "type": "fill", "source-layer": "water", "paint": { "fill-color": "rgb(27,27,29)" } },
    { "id": "waterway", "type": "line", "source-layer": "waterway", "paint": { "line-color": "rgb(27,27,29)" } },
    { "id": "building", "type": "fill", "source-layer": "building", "paint": { "fill-color": "rgb(10,10,10)", "fill-outline-color": "rgb(27,27,29)" } },
    { "id": "highway_track", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(5,5,5)" } },
    { "id": "highway_service", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(20,20,20)" } },
    { "id": "highway_minor", "type": "line", "source-layer": "transportation", "paint": { "line-color": "#181818" } },
    { "id": "highway_minor_space", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(27 27 29)" } },
    { "id": "highway_major_casing", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgba(60,60,60,0.8)" } },
    { "id": "highway_major_casing_slash", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(60 60 60 / 0.8)" } },
    { "id": "highway_major_casing_pct_alpha", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(60 60 60 / 80%)" } },
    { "id": "highway_major_casing_bad_alpha", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(60 60 60 / 80)" } },
    { "id": "highway_transparent", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgba(20,20,20,0)" } },
    { "id": "highway_pct_channels", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(50%,50%,50%)" } },
    { "id": "railway", "type": "line", "source-layer": "transportation", "paint": { "line-color": "rgb(35,35,35)" } },
    { "id": "boundary_state", "type": "line", "source-layer": "boundary", "paint": { "line-color": "hsl(0,0%,21%)" } },
    { "id": "boundary_state_space", "type": "line", "source-layer": "boundary", "paint": { "line-color": "hsl(0 0% 21%)" } },
    { "id": "boundary_country_z0-4", "type": "line", "source-layer": "boundary", "paint": { "line-color": "hsl(0,0%,23%)" } },
    { "id": "highway_motorway_inner", "type": "line", "source-layer": "transportation", "paint": { "line-color": ["interpolate", ["linear"], ["zoom"], 5.8, "hsla(0,0%,85%,0.53)", 6, "#000"] } },
    { "id": "highway_class_match", "type": "line", "source-layer": "transportation", "paint": { "line-color": ["match", ["get", "class"], "#181818", "#202020", "#000000", "#101010", "#050505"] } },
    { "id": "highway_zoom_step", "type": "line", "source-layer": "transportation", "paint": { "line-color": ["step", ["zoom"], "#0a0a0a", 10, "#141414", 14, "#1e1e1e"] } },
    { "id": "highway_case", "type": "line", "source-layer": "transportation", "paint": { "line-color": ["case", ["==", ["get", "brunnel"], "tunnel"], "#0a0a0a", "#141414"] } },
    { "id": "highway_name_motorway", "type": "symbol", "source-layer": "transportation_name", "paint": { "text-color": "hsl(0,0%,37%)" } },
    { "id": "place_city", "type": "symbol", "source-layer": "place", "paint": { "text-color": "rgb(101,101,101)", "text-halo-color": "rgba(0,0,0,0.7)" } },
    { "id": "place_continent", "type": "symbol", "source-layer": "place", "paint": { "text-color": "rgb(160,160,160)" } },
    { "id": "place_country", "type": "symbol", "source-layer": "place", "paint": { "text-color": "rgb(200,200,200)" } }
  ]
}
